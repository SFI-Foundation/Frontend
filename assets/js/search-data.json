---
---
{
  {% assign comma = false %}
  {%- assign date_format = site.minima.date_format | default: "%b %-d, %Y" -%}
  {% for post in site.posts %}
    {% if post.search_exclude != true %}
        {% if comma == true%},{% endif %}"post{{ forloop.index0 }}": {
            "title": {{ post.title | default: '' | replace: '&amp;', '&' | jsonify }},
            "content": {{ post.content | markdownify | replace: '</h', ' . </h' | replace: '<hr', ' . <hr' | replace: '</p', ' . </p' | replace: '</ul', ' . </ul' | replace: '</tr', ' . </tr' | replace: '</li', ' | </li' | replace: '</td', ' | </td' | strip_html | escape_once | remove: 'Table of contents' | remove: '```'  | remove: '---' | replace: '\', ' ' | replace: ' .  .  . ', ' . ' | replace: ' .  . ', ' . ' | normalize_whitespace | jsonify }},
            "url": {{ post.url | absolute_url | jsonify }},
            "relUrl": {{ post.url | jsonify }},
            "date": {{ post.date | date: date_format | prepend: ' • ' | jsonify }}
        }
        {% assign comma = true %}
    {% endif %}
  {% endfor %}

  {% for page in site.pages %}
  {% if page.url contains '.xml' or page.url contains 'assets'%}
  {% elsif page.search_exclude != true %}
      {% if comma == true%},{% endif %}"page{{ forloop.index0 }}": {
          "title": {{ page.title | default: '' | replace: '&amp;', '&' | jsonify }},
          "content": {{ page.content | markdownify | replace: '</h', ' . </h' | replace: '<hr', ' . <hr' | replace: '</p', ' . </p' | replace: '</ul', ' . </ul' | replace: '</tr', ' . </tr' | replace: '</li', ' | </li' | replace: '</td', ' | </td' | strip_html | escape_once | remove: 'Table of contents' | remove: '```'  | remove: '---' | replace: '\', ' ' | replace: ' .  .  . ', ' . ' | replace: ' .  . ', ' . ' | normalize_whitespace | jsonify }},
          "url": {{ page.url | absolute_url | jsonify }},
          "relUrl": {{ page.url | jsonify }},
          "date": ""
      }
      {% assign comma = true %}
  {% endif %}
{% endfor %}
}
